<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Personal Portfolio</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        header {
            background-color: #333;
            color: white;
            padding: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        header h1 {
            font-size: 25px;
        }

        nav {
            display: flex;
            gap: 25px;
        }

        nav a {
            color: white;
            text-decoration: none;
        }

        main {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 50px;
            padding: 50px;
        }

        .about {
            width: 50%;
        }

        .about h2 {
            margin-bottom: 15px;
        }

        .image {
            width: 300px;
            height: 300px;
            background-color: #ddd;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 80px;
            border-radius: 50%;
        }

        footer {
            background-color: #333;
            color: white;
            text-align: center;
            padding: 15px;
        }

        @media (max-width: 700px) {
            header {
                flex-direction: column;
                gap: 15px;
            }

            main {
                flex-direction: column;
                text-align: center;
            }

            .about {
                width: 100%;
            }
        }
    </style>
</head>

<body>

    <header>
        <h1>Pranjal Chaudhary</h1>

        <nav>
            <a href="#">Home</a>
            <a href="#">About</a>
            <a href="#">Skills</a>
            <a href="#">Contact</a>
        </nav>
    </header>

    <main>
        <section class="about">
            <h2>About Me</h2>
            <p>
                Hello! I am Pranjal Chaudhary, a Computer Science student
                interested in Data Science and technology. I enjoy learning
                programming and building useful projects.
            </p>
        </section>

        <section class="image">
            👨‍💻
        </section>
    </main>

    <footer>
        © 2026 Pranjal Chaudhary. All Rights Reserved.
    </footer>

</body>
</html>